# Optional for local development. Copy to .env at repository root.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
WEB_ORIGIN=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4000
DEMO_MODE=true
SEED_DEMO=true
# Development only. Replace with a secret generated using a CSPRNG in deployment.
QR_SECRET=development-only-change-this-secret-before-deployment-2026
SESSION_TTL_HOURS=168

# Optional Firebase Google / phone authentication. Public web app configuration.
# Set all four together; enable the providers in your Firebase console.
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_API_KEY=your-firebase-web-api-key
# FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
# FIREBASE_APP_ID=your-firebase-web-app-id
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_STORAGE_BUCKET=
FIREBASE_GOOGLE_ENABLED=true
FIREBASE_PHONE_ENABLED=true
# Server credentials: use Application Default Credentials or a service account
# file OUTSIDE this repository. Never put its JSON/private key in browser code.
# GOOGLE_APPLICATION_CREDENTIALS=C:/private/chainpass-firebase-service-account.json

# Optional Razorpay checkout. Start with TEST keys; set all three together.
# Keep both secrets server-side. Configure auto-capture and signed webhooks.
# RAZORPAY_KEY_ID=rzp_test_yourKeyId
# RAZORPAY_KEY_SECRET=your-server-only-key-secret
# RAZORPAY_WEBHOOK_SECRET=your-separate-webhook-secret
PAYMENT_HOLD_MINUTES=15
# Live keys require NODE_ENV=production, DEMO_MODE=false, SEED_DEMO=false.
# Railway reservations remain free simulations, even with Razorpay enabled.

# Default SQLite path: <repository>/data/chainpass.sqlite.
# SQLITE_PATH=/absolute/path/chainpass.sqlite
# Set DATABASE_URL to select PostgreSQL instead of SQLite.
# DATABASE_URL=postgresql://chainpass:password@127.0.0.1:5432/chainpass
# Docker's local database password. Change for any hosted deployment.
POSTGRES_PASSWORD=chainpass-local-only

BLOCKCHAIN_ENABLED=false
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Copy the real address printed by npm run chain:deploy.
# CONTRACT_ADDRESS=0x...
# Local chain can use its unlocked RPC signer. Production requires a secret key.
# CHAIN_PRIVATE_KEY=0x...
