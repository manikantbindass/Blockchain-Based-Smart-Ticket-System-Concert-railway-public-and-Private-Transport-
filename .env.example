# Optional for local development. Copy to .env at repository root.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
WEB_ORIGIN=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4000
DEMO_MODE=true
SEED_DEMO=true
# Development only. Replace with a secret generated using a CSPRNG in deployment.
QR_SECRET=development-only-change-this-secret-before-deployment-2026
SESSION_TTL_HOURS=168

# Default SQLite path: <repository>/data/chainpass.sqlite.
# SQLITE_PATH=/absolute/path/chainpass.sqlite
# Set DATABASE_URL to select PostgreSQL instead of SQLite.
# DATABASE_URL=postgresql://chainpass:password@127.0.0.1:5432/chainpass
# Docker's local database password. Change for any hosted deployment.
POSTGRES_PASSWORD=chainpass-local-only

BLOCKCHAIN_ENABLED=false
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Copy the real address printed by npm run chain:deploy.
# CONTRACT_ADDRESS=0x...
# Local chain can use its unlocked RPC signer. Production requires a secret key.
# CHAIN_PRIVATE_KEY=0x...
